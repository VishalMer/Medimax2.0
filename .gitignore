# Environment and local configuration
.env
.env.*
!.env.example
*.local

# Claude/VS Code machine-specific settings
.claude/settings.local.json
.claude/launch.json
.vscode/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs, dumps, and temporary files
*.log
